# Local AI (Bionic / LM Studio)
NOVA_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Free local fallback used when OpenAI is not configured or cannot respond.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b-2507

# Optional Runway real-time human character. Keep the secret server-side.
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_TYPE=preset
RUNWAY_AVATAR_ID=human-resource

# Nova's procedural 3D avatar needs no provider key and remains the fallback.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova

NEXT_PUBLIC_APP_URL=http://localhost:3000
