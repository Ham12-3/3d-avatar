generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AvatarSessionStatus {
  PREPARING
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

enum ToolExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
  DENIED
}

enum KnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

model AppUser {
  id          String           @id
  email       String?          @unique
  displayName String?
  role        String           @default("MEMBER")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  preference  UserPreference?
  sessions    AvatarSession[]
  auditLogs   AuditLog[]
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  theme             String   @default("system")
  captionsEnabled   Boolean  @default(true)
  microphoneDefault Boolean  @default(true)
  cameraDefault     Boolean  @default(false)
  screenSharePrompt Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RevenueEntry {
  id            String   @id @default(cuid())
  occurredAt    DateTime
  grossPence    Int
  feePence      Int      @default(0)
  currency      String   @default("GBP")
  source        String
  transactionId String   @unique
  metadata      Json?
  createdAt     DateTime @default(now())
  refunds       Refund[]
  @@index([occurredAt])
}

model Refund {
  id             String       @id @default(cuid())
  revenueEntryId String
  amountPence    Int
  reason         String
  occurredAt     DateTime
  status         String       @default("SUCCEEDED")
  createdAt      DateTime     @default(now())
  revenueEntry   RevenueEntry @relation(fields: [revenueEntryId], references: [id], onDelete: Cascade)
  @@index([occurredAt])
}

model SupportTicket {
  id           String         @id @default(cuid())
  ticketNumber Int            @unique
  title        String
  description  String
  status       TicketStatus
  priority     TicketPriority
  category     String
  assignedTeam String
  assignedUser String?
  customer     String
  createdAt    DateTime
  updatedAt    DateTime       @updatedAt
  @@index([status, priority])
  @@index([assignedTeam])
}

model AvatarSession {
  id                   String                @id @default(cuid())
  userId               String
  providerConversationId String?               @unique
  renderer               String                @default("browser-three")
  startedAt            DateTime              @default(now())
  endedAt              DateTime?
  durationSeconds      Int?
  status               AvatarSessionStatus   @default(PREPARING)
  transcript           Json?
  errorCode             String?
  user                  AppUser               @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolExecutions        AvatarToolExecution[]
  @@index([userId, startedAt])
}

model AvatarToolExecution {
  id         String              @id @default(cuid())
  sessionId  String
  toolName   String
  toolType   String
  arguments  Json
  result     Json?
  status     ToolExecutionStatus
  durationMs Int?
  createdAt  DateTime            @default(now())
  session    AvatarSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
  @@index([toolName])
}

model KnowledgeDocument {
  id               String          @id @default(cuid())
  name             String
  type             String
  content          String
  status           KnowledgeStatus @default(PROCESSING)
  tokenCount       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([status, updatedAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventName  String
  properties Json?
  occurredAt DateTime @default(now())
  @@index([eventName, occurredAt])
  @@index([userId, occurredAt])
}

model DashboardEvent {
  id         String   @id @default(cuid())
  userId     String?
  page       String
  action     String
  target     String?
  metadata   Json?
  occurredAt DateTime @default(now())
  @@index([page, occurredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}
